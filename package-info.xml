<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.simplemachines.org/xml/package-info">
<package-info xmlns="http://www.simplemachines.org/xml/package-info" xmlns:smf="http://www.simplemachines.org/">
	<id>Matthias:GlobalNewTopic</id>
	<name>Global New Topic</name>
	<version>1.0.0</version>
	<type>modification</type>

	<install for="2.1.0-2.1.99">
		<readme parsebbc="true">readme.txt</readme>

		<require-file name="Sources/GlobalNewTopic.php" destination="$sourcedir" />
		<require-file name="Themes/default/GlobalNewTopic.template.php" destination="$themes_dir/default" />
		<require-file name="Themes/default/languages/GlobalNewTopic.english.php" destination="$themes_dir/default/languages" />
		<require-file name="Themes/default/languages/GlobalNewTopic.german.php" destination="$themes_dir/default/languages" />
		<require-file name="Themes/default/languages/GlobalNewTopic.german_informal.php" destination="$themes_dir/default/languages" />

		<hook hook="integrate_load_theme" function="mcp_gnt_load_theme" file="$sourcedir/GlobalNewTopic.php" />
		<hook hook="integrate_admin_areas" function="mcp_gnt_admin_areas" file="$sourcedir/GlobalNewTopic.php" />
		<hook hook="integrate_modify_modifications" function="mcp_gnt_modify_modifications" file="$sourcedir/GlobalNewTopic.php" />

		<code type="file">install.php</code>
		<redirect url="?action=admin;area=modsettings;sa=globalnewtopic" />
	</install>

	<uninstall for="2.1.0-2.1.99">
		<hook reverse="true" hook="integrate_load_theme" function="mcp_gnt_load_theme" file="$sourcedir/GlobalNewTopic.php" />
		<hook reverse="true" hook="integrate_admin_areas" function="mcp_gnt_admin_areas" file="$sourcedir/GlobalNewTopic.php" />
		<hook reverse="true" hook="integrate_modify_modifications" function="mcp_gnt_modify_modifications" file="$sourcedir/GlobalNewTopic.php" />

		<code type="file">uninstall.php</code>

		<remove-file name="$sourcedir/GlobalNewTopic.php" />
		<remove-file name="$themes_dir/default/GlobalNewTopic.template.php" />
		<remove-file name="$themes_dir/default/languages/GlobalNewTopic.english.php" />
		<remove-file name="$themes_dir/default/languages/GlobalNewTopic.german.php" />
		<remove-file name="$themes_dir/default/languages/GlobalNewTopic.german_informal.php" />
	</uninstall>
</package-info>
